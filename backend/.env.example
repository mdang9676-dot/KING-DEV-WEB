# Sao chép thành backend/.env. KHÔNG commit/chia sẻ file .env.
# Đặt APP_SECRET ngẫu nhiên dài >= 32 ký tự (dùng để ký phiên đăng nhập và mã hoá API key AI của người dùng).
# Lệnh tạo: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Nếu bỏ trống, server tự sinh và lưu vào data/.app_secret (chỉ nên dùng khi thử nghiệm).
APP_SECRET=

DEBUG=false                 # true để bật /docs (tài liệu API)
REGISTRATION_OPEN=true      # false = đóng đăng ký tài khoản mới
TRUST_PROXY=false           # true nếu chạy sau reverse proxy (Replit, Nginx, Cloudflare...) để đọc IP/HTTPS đúng
# COOKIE_SECURE=true        # ép cookie chỉ gửi qua HTTPS (mặc định tự bật khi request là HTTPS)

MAX_UPLOAD_MB=2048
MAX_CONCURRENT_JOBS=1       # số video xuất song song (nặng: để 1)
VIDEO_CRF=18                # chất lượng video xuất (16-23; thấp = nét hơn, file to hơn)
VIDEO_PRESET=medium         # ultrafast..veryslow
RETENTION_HOURS=24          # xoá video tải lên/file tạm sau bấy nhiêu giờ
OUTPUT_RETENTION_HOURS=72   # xoá video kết quả sau bấy nhiêu giờ (nhớ tải về)

WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# ---- Giọng VieNeu-TTS + nhân bản giọng (cần: pip install -r requirements-voice.txt) ----
VIENEU_MODE=v3turbo         # v3turbo (48kHz, chất lượng cao) | v3nano (nhẹ ~3x, chất lượng thấp hơn — cho máy yếu)
VIENEU_PRECISION=fp32       # int8 nhanh hơn ~1.6x nhưng CẦN CPU có VNNI (AVX-512 VNNI/AVX-VNNI); CPU cũ có thể ra tiếng rè
VIENEU_BACKEND=             # để trống = tự chọn; onnx = ép chạy CPU
VIENEU_PRELOAD=false        # true = nạp model ngay khi khởi động
VOICE_CLONING_ENABLED=true   # false = tắt hẳn nhân bản giọng (mẫu đã có vẫn xoá được)
MAX_VOICE_CLONES_PER_USER=10
MAX_VOICE_SAMPLE_MB=25
